# 의존성
/node_modules
/.pnp
.pnp.*

# 시크릿 — 절대 커밋 금지
.env*

# 데모 SQLite DB — 첫 실행 때 시드로 자동 생성된다 (npm run db:reset 으로 재생성)
.data/

# next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# 테스트
/coverage

# AI 스크래치 (진실 아님)
.dev/

# 개인 설정 — 팀 공유 .claude/settings.json 과 분리
.claude/settings.local.json

# 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS/에디터
.DS_Store
Thumbs.db
*.pem

# Lighthouse 원본 리포트 — 요약(summary.md)만 커밋한다 (한 벌에 1MB 넘는다)
docs/measurements/*.report.html
docs/measurements/*.report.json
